<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\EverlongGlobalizationVersion.props"/>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <RootNamespace>Everlong.Globalization.Tools</RootNamespace>
    <PackageId>Everlong.Globalization.Tools</PackageId>
    <Authors>Richard Zheng</Authors>
    <Copyright>Copyright © 2026 Everlong Technology</Copyright>
    <Company>Everlong Technology</Company>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotnet-elg</ToolCommandName>
    <IsPackable>true</IsPackable>
    <Description>Everlong Globalization CLI — i18n language file management and code generation.</Description>
    <PackageTags>Globalization;Localization;i18n;CodeGen</PackageTags>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/omrzh/Everlong.Globalization</PackageProjectUrl>
    <RepositoryUrl>https://github.com/omrzh/Everlong.Globalization</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- The option table, the config reader and the line-ending resolution are internals; the test
       suite pins them (the scaffold's key set, the docs' key set, the four config miss classes). -->
  <ItemGroup>
    <InternalsVisibleTo Include="Everlong.Globalization.Tools.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="icon.png" Pack="true" PackagePath="\"/>
    <None Include="readme.md" Pack="true" PackagePath="\"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
  </ItemGroup>
</Project>
